# JalurEkspor — variabel lingkungan
#
# Salin berkas ini menjadi `web/.env` lalu isi nilainya.
#   cp .env.example .env
#
# Kenapa `.env` dan bukan `.env.local`?
#   Prisma CLI (`prisma migrate`, `prisma db seed`) HANYA membaca `.env`.
#   Next.js membaca `.env` juga (prioritas paling rendah), jadi satu berkas cukup.
#
# PENTING: `.gitignore` saat ini hanya mengabaikan `.env*.local`.
#   Sebelum commit pertama, tambahkan baris `.env` ke `web/.gitignore`,
#   atau taruh nilai aslinya di `.env.local` DAN `.env` sekaligus.
#   (Berkas `.gitignore` milik PM — backend tidak menyuntingnya.)

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. HANYA dipakai di Route Handler / seed.
# JANGAN pernah diberi prefix NEXT_PUBLIC_ dan jangan pernah dikirim ke klien.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Postgres — Project Settings → Database → Connection string
#
# DUA URL, dan salah satunya sering tertukar. Kalau tertukar,
# `prisma migrate` akan MENGGANTUNG tanpa pesan error.
#
#   DATABASE_URL : Transaction pooler, port 6543, WAJIB `?pgbouncer=true`
#                  Dipakai runtime aplikasi (banyak koneksi pendek).
#   DIRECT_URL   : Koneksi langsung, port 5432, TANPA pgbouncer.
#                  Dipakai `prisma migrate` dan `prisma db seed`.
#
# Sandi berisi karakter khusus? URL-encode dulu (@ → %40, # → %23).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# OpenRouter — hanya untuk menulis narasi draft.
# Kalau kosong / gagal / timeout, backend otomatis memakai fallback
# deterministik (lib/server/ai/fallback.ts) dan keyakinan = "rendah".
# Demo tetap jalan tanpa kunci ini.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# Opsional: matikan pemanggilan LLM sepenuhnya (selalu pakai fallback).
# Berguna untuk demo di WiFi yang tidak bisa diandalkan.
JALUREKSPOR_DISABLE_LLM=false
